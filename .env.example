# Copier vers .env.local et renseigner les valeurs.

# --- Navigateur (préfixe VITE_) : uniquement des valeurs publiques ---------------
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon

# --- Serveur (fonctions /api) : jamais exposées au navigateur -------------------
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre-cle-anon
# Les endpoints IA agissent avec le jeton de l'utilisateur (RLS) : pas de clé service_role ici.

# Vercel AI Gateway : une seule clé pour tous les modèles
AI_GATEWAY_API_KEY=

# Modèles (facultatif, valeurs par défaut européennes)
# AI_MODEL_LANGUAGE=mistral/mistral-medium-3.5
# AI_MODEL_TRANSCRIPTION=mistral/voxtral-small-transcribe-3
# AI_MODEL_EMBEDDING=mistral/mistral-embed

# Conservation de l'audio : delete_after_transcription (défaut) ou keep
# RECORDING_RETENTION=delete_after_transcription
